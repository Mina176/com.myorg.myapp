<mvc:View
	controllerName="com.myorg.myapp.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"	>
	<Page
		title="{i18n>appTitle}"
		id="idMainPage" 
		>
		<headerContent>
		<Button id="idAddEmployeeButton"
                icon="sap-icon://add"
                text="Add Employee" type="Emphasized"
                press=".onAddEmployeeButtonPress" />
		</headerContent>
            <Toolbar id="idSearchToolbar" >
                <SearchField 
                    id="idEmployeeSearchField" 
                    placeholder="Search employee..." 
                    liveChange=".onSearchFieldLiveChange" />
            </Toolbar>
		<content>
				<List id="idEmployeesList" items="{ZEMPDATASet}" >
			<items>
			<ObjectListItem id="idObjectListItem"  title="{employeeModel>name}" 
                intro="{employeeModel>position}"
                type="Navigation"
				tooltip="id: {employeeModel>id}"
				press="onObjectListItemPress">
				<attributes>
                    <ObjectAttribute id="idIdObjectAttribute" 
                        title="id" 
                        text="{employeeModel>id}" />
                </attributes>
				</ObjectListItem>
			</items>
			</List>
		</content>
	</Page>

</mvc:View>