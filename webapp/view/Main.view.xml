<mvc:View
	controllerName="com.myorg.myapp.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"	>
	<Page
		title="{i18n>appTitle}"
		id="idMainPage">
            <Toolbar id="idSearchToolbar" >
                <SearchField 
                    id="idEmployeeSearchField" 
                    placeholder="Search employee..." 
                    liveChange=".onSearchFieldLiveChange" />
            </Toolbar>
		<content>
				<List id="idEmployeesList" items="{/ZEMPDATASet}" >
			<items>
			<ObjectListItem 
				id="idObjectListItem"
				title="{ZempName}"
                intro="{Zposition}"
				tooltip="id: {ZempId}"
                type="Navigation"
				press="onObjectListItemPress">
				</ObjectListItem>
			</items>
			</List>
		</content>
	</Page>

</mvc:View>