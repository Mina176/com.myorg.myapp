<mvc:View xmlns:core="sap.ui.core"
    controllerName="com.myorg.myapp.controller.Main"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <Page
        title="{i18n>appTitle}"
        id="idMainPage">
        <headerContent>
            <ToggleButton id="idEditModeButton"
                icon="sap-icon://edit"
                text="Edit"
                tooltip="Tap an employee to edit it"
                press=".onEditModeToggle" />
            <Button id="idAddEmployeeButton"
                icon="sap-icon://add"
                text="Add Employee"
                type="Emphasized"
                press=".onAddEmployeeButtonPress" />
        </headerContent>
        <content>
            <List id="idEmployeesList" items="{/ZEMPDATASet}">
                <items>
                    <ObjectListItem id="idEmployeeItem"
                        title="{ZempName}"
                        type="Navigation"
                        press=".onItemPress">
                        <attributes>
                            <ObjectAttribute id="idPositionAttr" text="{Zposition}" />
                            <ObjectAttribute id="idDepartmentAttr" text="{Zdepartment}" />
                        </attributes>
                    </ObjectListItem>
                </items>
            </List>
        </content>
    </Page>

</mvc:View>